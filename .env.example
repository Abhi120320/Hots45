# Backend settings. Copy to .env and edit.
# Folder holding cells.parquet, points.parquet, meta.json (default: backend/app_data)
APP_DATA=backend/app_data
# Comma-separated origins allowed to call the API ("*" = any). Set to your frontend URL in production.
CORS_ORIGINS=*
# Port used by docker compose
PORT=8000
# NASA FIRMS API key (https://firms.modaps.eosdis.nasa.gov/api/map_key/) for live NRT updates
FIRMS_MAP_KEY=
# NASA Earthdata login (https://urs.earthdata.nasa.gov) for data_prep/land_cover.py fetch (MODIS land cover via AppEEARS)
EARTHDATA_USER=
EARTHDATA_PASS=
